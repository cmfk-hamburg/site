---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import * as sodaInterview from "../../content/en/soda-interview.md";

const Content = sodaInterview.Content;
---

<ArticleLayout
  title={sodaInterview.frontmatter.htmlTitle}
  article={sodaInterview}
>
  <div class="text-module__head">
    <h2 class="text-module__headline">
      {sodaInterview.frontmatter.headline2}
    </h2>

    <div class="text-module__cta-wrapper">
      <a
        class="text-module__cta btn btn--primary"
        href={sodaInterview.frontmatter.buttonLink}
        target="_blank"
      >
        {sodaInterview.frontmatter.buttonText}
      </a>
    </div>
  </div>

  <div class="text-module__content">

    <div class="soda-video-player">
      <video controls playsinline preload="metadata">
        <source
          src="/videos/soda-promotion-video-CN.mp4"
          type="video/mp4"
        />
        Your browser does not support the video tag.
      </video>
    </div>

    <Content />

  </div>
</ArticleLayout>

<style>
  .soda-video-player {
    width: 900px;
    max-width: 100%;
    aspect-ratio: 16 / 9;
    margin: 30px auto 50px;
    background: #000;
  }

  .soda-video-player video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000;
  }
</style>
