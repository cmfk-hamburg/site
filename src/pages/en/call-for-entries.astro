---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import * as callForFilm from "../../content/en/call-for-film.md";

const Content = callForFilm.Content;
---

<ArticleLayout title={callForFilm.frontmatter.htmlTitle} article={callForFilm}>
	<div class="text-module__head">
		<h2 class="text-module__headline">
			{callForFilm.frontmatter.headline2}
		</h2>
		<div class="text-module__cta-wrapper">
			<a
				class="text-module__cta btn btn--primary"
				href={callForFilm.frontmatter.buttonLink}
				target="_blank"
			>
				<img src={callForFilm.frontmatter.buttonImage} alt="FilmFreeway" />
			</a>
			<a
				class="text-module__cta btn btn--primary"
				href="https://www.toujiang.today/filmfest/182"
				target="_blank"
			>
				Toujiang
			</a>
		</div>
	</div>
	<div class="text-module__content">
		<Content />
	</div>
</ArticleLayout>
