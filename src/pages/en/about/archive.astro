---
import ArticleLayout from "../../../layouts/ArticleLayout.astro";

const article = {
	frontmatter: {
		headline: "Archive",
		overline: "About",
		imageSrcS: "url(/images/logo-white-3.svg)",
		imageSrcM: "url(/images/logo-white-1.svg)",
		imageSrcL: "url(/images/logo-white-2.svg)",
	},
};
---

<ArticleLayout title="Archive" article={article}>
	<div class="archive-page">
		<section class="archive-hero" aria-labelledby="archive-past-editions">
			<div class="archive-hero__banner">
				<div class="archive-hero__intro">
					<h2 id="archive-past-editions">Past Editions</h2>
					<p class="archive-hero__summary">
						Since 2023, the Chinese Film Festival Hamburg (CFFH) has successfully
						presented three editions, showcasing independent Chinese-language
						films from around the world. Click on a poster to explore each year’s
						program, jury, awards, and highlights.
					</p>
				</div>
			</div>
			<div class="archive-grid">
				<article class="archive-card">
					<div class="archive-card__poster">
						<img src="/images/poster/2025-poster_page-0001.jpg" alt="Festival poster 2025" loading="lazy" />
					</div>
					<div class="archive-card__body">
						<h3>2025</h3>
						<p class="archive-card__meta">4. Edition · May 7–11, 2025</p>
						<p>Screened 26 Films · Theme: 扩延边界 | Expanding Boundaries</p>
					</div>
				</article>
				<article class="archive-card">
					<div class="archive-card__poster">
						<img src="/images/poster/2024-poster_page-0001.jpg" alt="Festival poster 2024" loading="lazy" />
					</div>
					<div class="archive-card__body">
						<h3>2024</h3>
						<p class="archive-card__meta">2. Edition · May 8–13, 2024</p>
						<p>Screened 35 Films · Theme: Film Plus</p>
					</div>
				</article>
				<article class="archive-card">
					<div class="archive-card__poster">
						<img src="/images/poster/2023-poster.jpg" alt="Festival poster 2023" loading="lazy" />
					</div>
					<div class="archive-card__body">
						<h3>2023</h3>
						<p class="archive-card__meta">1. Edition · Jan 8–15, 2023</p>
						<p>Screened 26 Films · Theme: 夜行 | Night Walk</p>
					</div>
				</article>
			</div>
		</section>

		<section class="archive-edition" id="edition-2025" aria-labelledby="edition-2025-title">
			<header class="archive-edition__banner">
				<div>
					<p class="archive-edition__eyebrow">Edition Focus</p>
					<h2 id="edition-2025-title">Chinese Film Festival Hamburg 2025</h2>
					<p class="archive-edition__meta">May 7–11, 2025 · Hamburg</p>
					<p class="archive-edition__theme">Theme: 扩延边界 | Expanding Boundaries</p>
					<p class="archive-edition__summary">
						A four day showcase of independent Chinese cinema featuring a
						special focus on new voices, documentary works, and cross regional
						co productions.
					</p>
				</div>
				<div class="archive-edition__actions">
					<a class="btn btn--secondary" href="/en/program2025/">View Complete Program</a>
				</div>
			</header>


			<section class="archive-section" id="jury-2025">
				<div class="archive-section__head">
					<h3>Final jury members</h3>
					<p>A panel of filmmakers, producers, and critics from China and Europe.</p>
				</div>
				<div class="archive-jury archive-jury--final">
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/final/2025-final-person1.JPG" alt="Guo Keyu" loading="lazy" />
						<h4>Guo Keyu | 郭柯宇</h4>
						<p>
							Chinese actress. At 17, she became the youngest Best Actress winner
							at China’s Hundred Flowers Awards and the first Chinese actress to
							claim the top prize at the Shanghai International Film Festival for
							Red Cherry (1995). Following a decade-long hiatus, her starring
							role in Brief History of a Family (2023) screened at Berlinale and
							the Sundance Film Festival. Nominated for Best Supporting Actress at
							the 2024 Golden Rooster Awards for Another Day of Hope, she is widely
							praised for her nuanced artistry.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/final/2025-final-person2.jpg" alt="Christopher Small" loading="lazy" />
						<h4>Christopher Small</h4>
						<p>
							Writer living in Prague, Czech Republic. Editor of Outskirts Film
							Magazine and part of the Locarno Film Festival’s editorial and
							publications team. He also programs films and occasionally makes
							them.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/final/2025-final-person3.jpg" alt="Helena Wittmann" loading="lazy" />
						<h4>Helena Wittmann</h4>
						<p>
							Artist and filmmaker based in Hamburg, Germany. Her films, including
							Human Flowers of Flesh (2022) and Drift (2017), have screened
							internationally at film festivals and exhibitions and received
							awards. She teaches at the Hamburg Academy of Fine Arts and Elias
							Querejeta Zine Eskola in San Sebastian, Spain. She also creates
							installation works and collaborates as DoP with various directors
							and artists.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/final/2025-final-person4.JPG" alt="Zhen Zhang" loading="lazy" />
						<h4>Zhen Zhang | 张真</h4>
						<p>
							Professor and director of the Asian Film and Media Initiative at New
							York University. As curator, she has programmed film series for Reel
							China Biennial at NYU, Film Society at the Lincoln Center for
							Performing Arts, MoMA, and Women Make Waves International Film
							Festival. She has also served on numerous film festival juries. Her
							creative work ranges from poetry, experimental memoir, filmmaking,
							and performance.
						</p>
					</article>
				</div>
			</section>

			<section class="archive-section" id="jury-2025-second">
				<div class="archive-section__head">
					<h3>Second round jury</h3>
					<p>Six jurors reviewing the second round selections.</p>
				</div>
				<div class="archive-jury archive-jury--second">
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/second/2025-second-person1.jpeg" alt="Ocean Chin" loading="lazy" />
						<h4>Ocean Chin | 秦海</h4>
						<p>
							Taiwanese director and DP. FAMU alumnus. Directed A Year Apart
							(2023) and worked as DP on various shorts and features. Selected for
							Golden Horse Film Academy in 2018.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/second/2025-second-person2.jpg" alt="Qian Han" loading="lazy" />
						<h4>Qian Han | 韩倩</h4>
						<p>
							Born in Wuhan, studied in Rome and Paris. Her art explores time,
							memory, and fragile materials to link family history with collective
							memory and space. She has exhibited internationally.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/second/2025-second-person3.jpg" alt="Mickey Lai" loading="lazy" />
						<h4>Mickey Lai</h4>
						<p>
							Malaysian director. WAShhh won Locarno77 Pardino d’Oro. Alumna of
							Golden Horse Film Academy and Locarno Spring Academy, she explores
							identity and mortality through fiction and documentary.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/second/2025-second-person4.jpeg" alt="Faezeh Nikoozad" loading="lazy" />
						<h4>Faezeh Nikoozad</h4>
						<p>
							Iranian filmmaker and video artist in Hamburg. Explores migration,
							identity, and the intersection of the personal and political through
							documentary and experimental visual storytelling.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/second/2025-second-person5.JPG" alt="Xun Yuan" loading="lazy" />
						<h4>Xun Yuan | 袁勋</h4>
						<p>
							Award-winning documentary director and cinematographer. Blends
							Eastern and Western cultures through a unique artistic expression.
							His film won the CFFH Jury Award in 2024.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/second/2025-second-person6.jpg" alt="Kailuo Zhuo" loading="lazy" />
						<h4>Kailuo Zhuo | 卓楷罗</h4>
						<p>
							Born in Panjin, China. Graduated from and now teaches at Lu Xun
							Academy of Fine Arts. Works across fiction and documentary as
							screenwriter, director, and educator.
						</p>
					</article>
				</div>
			</section>

			<section class="archive-section" id="jury-2025-first">
				<div class="archive-section__head">
					<h3>First round jury</h3>
					<p>Eleven jurors from film, research, and art.</p>
				</div>
				<div class="archive-jury archive-jury--first">
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person1.jpg" alt="Amarsanaa Battulga" loading="lazy" />
						<h4>Amarsanaa Battulga</h4>
						<p>
							Mongolian film critic and PhD researcher. Alumnus of Berlinale
							Talent Press. Served on juries at Locarno and Golden Ger. Published
							in Die Welt, Cineuropa, and Documentary Magazine.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person2.jpg" alt="Zhiwen Ding" loading="lazy" />
						<h4>Zhiwen Ding (they/them)</h4>
						<p>
							Studied screenwriting at Beijing Film Academy, fictional direction
							and editing at HFF Munich, and is pursuing an MA in Film Studies at
							FU Berlin. Explores queer-feminist views, identity, migration, and
							family.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person3.jpg" alt="Jinhyun Kim" loading="lazy" />
						<h4>Jinhyun Kim</h4>
						<p>
							Korean filmmaker studying at KHM Cologne. Explores personal and
							collective experience under dominant narratives. Blue, Woman, Dress
							(2023) screened at DMZ Docs, BIFF, and Hamburg SFF.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person4.jpg" alt="Pincent Liu" loading="lazy" />
						<h4>Pincent Liu</h4>
						<p>
							Programmer for Wuhan Photography Art Centre and Wuhan Art Book Fair.
							Programs, edits, and translates for Wuhan Bailin Film Festival,
							DUFANG FILM PROGRAM, and Hainan Island IFF.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person5.jpg" alt="Tanita Olbrich" loading="lazy" />
						<h4>Tanita Olbrich</h4>
						<p>
							Berlin-based artist and filmmaker. Studied at HFBK Hamburg with
							Angela Schanelec and Jeanne Faust. Her work has shown at Grotto
							Berlin, Kunsthaus Hamburg, Kunstverein Kassel, and festivals.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person6.jpg" alt="Hanqi Sheng" loading="lazy" />
						<h4>Hanqi Sheng</h4>
						<p>
							Hamburg-based filmmaker and director of CFFH. Holds MAs from China
							Academy of Art and HFBK Hamburg. Her award-winning works have screened
							at Visions du Reel, DOK Leipzig, and more.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person7.jpg" alt="Yao Su" loading="lazy" />
						<h4>Yao Su</h4>
						<p>
							Filmmaker and artist based in Germany. Studied directing at the
							National Academy of Chinese Theatre Arts and is now at KHM Cologne.
							Works with narrative and experimental films exploring memory and
							landscape.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person8.jpg" alt="Freya Woo" loading="lazy" />
						<h4>Freya Woo</h4>
						<p>
							Chinese filmmaker and lecturer at UCA London. Directed Reaction,
							awarded in Shanghai, Tokyo, and Rome. Contributed to works such as
							Shadow (2018, dir. Yimou Zhang), Ganapath, and others.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person9.jpg" alt="Run Yuan" loading="lazy" />
						<h4>Run Yuan</h4>
						<p>
							Independent curator based in Berlin with a background in literature
							and media. Curates interdisciplinary, experimental, and Asian-focused
							projects exploring narrative and immersion.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person10.jpg" alt="Jiawen Zhang" loading="lazy" />
						<h4>Jiawen Zhang</h4>
						<p>
							PhD candidate in Film Studies at the University of Bamberg. Founder
							of 706 Hamburger, a space for dialogue, critical exchange, and
							cross-cultural interaction.
						</p>
					</article>
					<article class="archive-jury__card">
						<img src="/assets/2025/jury/first/2025-first-person11.jpg" alt="Zhichao Zhu" loading="lazy" />
						<h4>Zhichao Zhu</h4>
						<p>
							Visual artist based in Shanghai and Hamburg, PhD candidate at HFBK
							Hamburg, and co-founder of CFFH. His work explores personal memory
							amid China’s socio-political change and has been shown
							internationally.
						</p>
					</article>
				</div>
			</section>

			<section class="archive-section" id="awards-2025">
				<div class="archive-section__head">
					<h3>Award winners</h3>
