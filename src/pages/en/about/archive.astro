<script>
	const carousels = document.querySelectorAll(".archive-gallery-carousel");

	carousels.forEach((carousel) => {
		const track = carousel.querySelector(".archive-gallery__track");
		const controls = carousel.querySelectorAll(".archive-gallery__control");
		let autoplayId = 0;
		let isPaused = false;

		if (!track) {
			return;
		}

		const prefersReducedMotion = window.matchMedia(
			"(prefers-reduced-motion: reduce)"
		);

		const getScrollStep = () => track.clientWidth * 0.9;
		const getMaxScrollLeft = () => track.scrollWidth - track.clientWidth;
		const isAtEnd = () => track.scrollLeft >= getMaxScrollLeft() - 4;
		const scrollToStart = () => track.scrollTo({ left: 0, behavior: "smooth" });
		const scrollNext = () => {
			if (isAtEnd()) {
				scrollToStart();
				return;
			}
			track.scrollBy({
				left: getScrollStep(),
				behavior: "smooth",
			});
		};
		const stopAutoplay = () => {
			if (!autoplayId) {
				return;
			}
			clearInterval(autoplayId);
			autoplayId = 0;
		};
		const startAutoplay = () => {
			if (prefersReducedMotion.matches || autoplayId) {
				return;
			}
			autoplayId = window.setInterval(() => {
				if (!isPaused) {
					scrollNext();
				}
			}, 4500);
		};

		controls.forEach((button) => {
			button.addEventListener("click", () => {
				const direction = button.getAttribute("data-direction");
				const offset = getScrollStep();
				track.scrollBy({
					left: direction === "next" ? offset : -offset,
					behavior: "smooth",
				});
			});
		});

		const pause = () => {
			isPaused = true;
		};
		const resume = () => {
			isPaused = false;
		};

		carousel.addEventListener("mouseenter", pause);
		carousel.addEventListener("mouseleave", resume);
		carousel.addEventListener("focusin", pause);
		carousel.addEventListener("focusout", resume);

		startAutoplay();
		window.addEventListener("beforeunload", stopAutoplay);
	});
</script>
