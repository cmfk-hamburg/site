---
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const page = {
  frontmatter: {
    headline: "Accreditation",
    headline2: "Accreditation"
  }
};
---

<ArticleLayout title={page.frontmatter.headline} article={page}>
  <div class="text-module__head text-module__head--with-tab text-module__head--team">
    <blockquote class="text-module__headline">
      <div>{page.frontmatter.headline2}</div>
    </blockquote>

    <ul class="text-module__tabs">
      <li class="text-module__tab">
        <a href={`/${lang}/about`} class="text-module__tab-link" title={t("nav.festival")}>
          <span class="text-module__tab-link-text">
            {t("nav.festival")}
          </span>
        </a>
      </li>
      <li class="text-module__tab">
        <a href={`/${lang}/about/team`} class="text-module__tab-link" title={t("nav.team")}>
          <span class="text-module__tab-link-text">
            {t("nav.team")}
          </span>
        </a>
      </li>
      <li class="text-module__tab is-active">
        <a href={`/${lang}/about/accreditation`} class="text-module__tab-link" title="Accreditation">
          <span class="text-module__tab-link-text">
            Accreditation
          </span>
        </a>
      </li>
    </ul>
  </div>

  <div class="text-module">
    <h2>Application Information</h2>
    <p>Please use this page to apply for festival accreditation. We will contact you by email after review.</p>

    <h2>Who Can Apply</h2>
    <p>Volunteers, media, guests, staff members, partners</p>

    <h2>Required Information</h2>
    <p>Name, organisation, contact details, accreditation type, ID photo, additional notes</p>

    <h2>Application</h2>
    <p>
      <a href="REPLACE_WITH_FORM_LINK" target="_blank" rel="noopener noreferrer">
        Apply Now
      </a>
    </p>

    <h2>Contact</h2>
    <p>info@chinesefilmfest.de</p>
  </div>
</ArticleLayout>

<style lang="scss">
  body {
    font-family: 'Noto Sans SC', sans-serif;
  }
</style>
