---
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import * as tickets from "../../../content/en/tickets.md";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const Content = tickets.Content;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ArticleLayout title={tickets.frontmatter.htmlTitle} article={tickets}>
	<div class="text-module__content">
		<div class="tickets-flyer-links">
			<a class="tickets-flyer-btn" href="/assets/2026_CFFH_Flyer_Final.pdf" download>
				<span>2026 Flyer</span>
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					viewBox="0 0 16 16"
					aria-hidden="true"
				>
					<path
						d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"
					/>
					<path
						d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"
					/>
				</svg>
			</a>
		</div>

		<Content />
	</div>
</ArticleLayout>

<style>
	.tickets-flyer-links {
		display: flex;
		justify-content: flex-end;
		margin-bottom: 2.5rem;
	}

	.tickets-flyer-btn,
	.tickets-flyer-btn:visited,
	.tickets-flyer-btn:hover,
	.tickets-flyer-btn:focus,
	.tickets-flyer-btn:active {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.8rem 1.25rem;
		background-color: #00c389 !important;
		border: 1px solid #00c389 !important;
		color: #ffffff !important;
		text-decoration: none !important;
		opacity: 1 !important;
		box-shadow: none !important;
		outline: none !important;
		transition: none !important;
	}

	.tickets-flyer-btn span,
	.tickets-flyer-btn:visited span,
	.tickets-flyer-btn:hover span,
	.tickets-flyer-btn:focus span,
	.tickets-flyer-btn:active span {
		color: #ffffff !important;
		text-decoration: none !important;
		border-bottom: none !important;
	}

	.tickets-flyer-btn svg,
	.tickets-flyer-btn:visited svg,
	.tickets-flyer-btn:hover svg,
	.tickets-flyer-btn:focus svg,
	.tickets-flyer-btn:active svg {
		fill: #ffffff !important;
		color: #ffffff !important;
		flex-shrink: 0;
	}

	.tickets-flyer-btn::after,
	.tickets-flyer-btn:hover::after,
	.tickets-flyer-btn:focus::after,
	.tickets-flyer-btn:active::after {
		display: none !important;
		content: none !important;
	}
</style>
