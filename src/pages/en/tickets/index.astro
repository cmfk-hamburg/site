---
import ArticleLayout from "../../../layouts/ArticleLayout.astro";
import * as tickets from "../../../content/en/tickets.md";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const Content = tickets.Content;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<ArticleLayout title={tickets.frontmatter.htmlTitle} article={tickets}>
	<div class="text-module__content">
		<div class="program__links">
			<a class="btn btn--primary" href="/assets/2026_CFFH_Flyer_Final.pdf" download>
				2026 Flyer
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="20"
					height="20"
					fill="currentColor"
					class="bi bi-download"
					viewBox="0 0 16 16"
				>
					<path
						d="M.5 9.9a.5.5 0 0 1 .5.5v2.5a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-2.5a.5.5 0 0 1 1 0v2.5a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2v-2.5a.5.5 0 0 1 .5-.5"
					/>
					<path
						d="M7.646 11.854a.5.5 0 0 0 .708 0l3-3a.5.5 0 0 0-.708-.708L8.5 10.293V1.5a.5.5 0 0 0-1 0v8.793L5.354 8.146a.5.5 0 1 0-.708.708z"
					/>
				</svg>
			</a>
		</div>

		<Content />
	</div>
</ArticleLayout>

<style>
	.program__links .btn.btn--primary,
	.program__links .btn.btn--primary:visited,
	.program__links .btn.btn--primary:hover,
	.program__links .btn.btn--primary:active,
	.program__links .btn.btn--primary:focus {
		background-color: #00c389 !important;
		color: #fff !important;
		border: 1px solid #00c389 !important;
		opacity: 1 !important;
	}

	.program__links .btn.btn--primary svg,
	.program__links .btn.btn--primary:hover svg,
	.program__links .btn.btn--primary:active svg,
	.program__links .btn.btn--primary:focus svg {
		color: #fff !important;
		fill: currentColor !important;
	}
</style>
