---
import * as exhibition from "../../../content/en/programs/exhibition.md";
import FilmLayout from "../../../layouts/FilmLayout.astro";
import ExhibitionDetail from "../../../components/ExhibitionDetail.astro";

const Content = exhibition.Content;
const fm = exhibition.frontmatter;
---

<FilmLayout title={fm.title} article={exhibition}>
  <ExhibitionDetail
    overline={fm.overline}
    title={fm.title}
    image={fm.image}
    date={fm.date}
    venue={fm.venue}
    address={fm.address}
    ticket={fm.ticket}
    curator={fm.curator}
    team={fm.team}
    intro={fm.intro}
    seminar={fm.seminar}
    opening={fm.opening}
    openingHours={fm.openingHours}
    performance={fm.performance}
    artists={fm.artists}
    works={fm.works}
  >
    <Content />
  </ExhibitionDetail>
</FilmLayout>
