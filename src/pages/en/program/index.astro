---
import ProgramLayout from "../../../layouts/ProgramLayout.astro";
import * as programs from "../../../content/en/programs.md";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";
import ProgramCollection from "../../../components/ProgramCollection.astro";

const Content = programs.Content;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const program0507 = await Astro.glob("../../../content/en/programs/0507/*.md");
const program0508 = await Astro.glob("../../../content/en/programs/0508/*.md");
const program0509 = await Astro.glob("../../../content/en/programs/0509/*.md");
const program0510 = await Astro.glob("../../../content/en/programs/0510/*.md");
const program0511 = await Astro.glob("../../../content/en/programs/0511/*.md");
const specialEvent = await Astro.glob("../../../content/en/programs/*.md");
---

<ProgramLayout title={programs.frontmatter.htmlTitle} article={programs}>
	{}
	<div class="programs">
		<ProgramCollection programs={program0507} date="07.05.2025" />
		<ProgramCollection programs={program0508} date="08.05.2025" />
		<ProgramCollection programs={program0509} date="09.05.2025" />
		<ProgramCollection programs={program0510} date="10.05.2025" />
		<ProgramCollection programs={program0511} date="11.05.2025" />
		<ProgramCollection programs={specialEvent} date="09.05.2025 - 22.06.2025" />
	</div>
	<!-- <img src="/images/coming-soon.jpg" alt="Program comming soon" style="width: 100%; margin: 36px auto 60px;"/> -->
</ProgramLayout>
