---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const page = {
  frontmatter: {
    headline: "证件申请",
    headline2: "证件申请"
  }
};
---

<ArticleLayout title={page.frontmatter.headline} article={page}>
  <div class="text-module__head">
    <blockquote class="text-module__headline">
      <div>{page.frontmatter.headline2}</div>
    </blockquote>
  </div>

  <div class="text-module">
    <h2>申请说明</h2>
    <p>
      欢迎媒体从业者申请本届影展媒体证件。提交后，我们将对申请进行审核，并通过邮件与您联系。
    </p>

    <h2>申请对象</h2>
    <p>媒体 / Press</p>

    <h2>申请表</h2>

    <form class="accreditation-form" method="POST">
      <fieldset class="accreditation-form__section">
        <legend>个人与职业信息</legend>

        <div class="form-grid">
          <div class="form-field">
            <label for="fullName">姓名 *</label>
            <input id="fullName" name="fullName" type="text" required />
          </div>

          <div class="form-field">
            <label for="badgeName">证件显示姓名 *</label>
            <input id="badgeName" name="badgeName" type="text" required />
          </div>

          <div class="form-field">
            <label for="email">邮箱 *</label>
            <input id="email" name="email" type="email" required />
          </div>

          <div class="form-field">
            <label for="phone">电话号码</label>
            <input id="phone" name="phone" type="tel" />
          </div>

          <div class="form-field">
            <label for="location">国家 / 城市 *</label>
            <input id="location" name="location" type="text" required />
          </div>

          <div class="form-field">
            <label for="mediaOutlet">所属媒体 *</label>
            <input id="mediaOutlet" name="mediaOutlet" type="text" required />
          </div>

          <div class="form-field">
            <label for="jobTitle">职位 *</label>
            <input id="jobTitle" name="jobTitle" type="text" required />
          </div>

          <div class="form-field">
            <label for="mediaType">媒体类型 *</label>
            <select id="mediaType" name="mediaType" required>
              <option value="">请选择</option>
              <option value="print">平面媒体</option>
              <option value="online">线上媒体</option>
              <option value="tv">电视</option>
              <option value="radio">广播</option>
              <option value="freelance">自由撰稿人</option>
              <option value="photographer">摄影师</option>
              <option value="videographer">摄像师</option>
              <option value="blogger">博主 / 独立媒体</option>
              <option value="other">其他</option>
            </select>
          </div>

          <div class="form-field">
            <label for="outletWebsite">媒体官网 *</label>
            <input id="outletWebsite" name="outletWebsite" type="url" required />
          </div>

          <div class="form-field">
            <label for="profileLink">个人主页 / 作品集</label>
            <input id="profileLink" name="profileLink" type="url" />
          </div>
        </div>
      </fieldset>

      <fieldset class="accreditation-form__section">
        <legend>报道信息</legend>

        <div class="form-field">
          <label for="recentCoverageLinks">近期报道链接 *</label>
          <p class="form-help">请填写 2–3 条近期可公开访问的报道链接，每行一条。</p>
          <textarea
            id="recentCoverageLinks"
            name="recentCoverageLinks"
            rows="6"
            required
          ></textarea>
        </div>

        <div class="form-field">
          <label for="plannedCoverage">计划如何报道本电影节？ *</label>
          <textarea
            id="plannedCoverage"
            name="plannedCoverage"
            rows="4"
            required
          ></textarea>
        </div>

        <div class="form-field">
          <label for="applicationReason">为什么申请媒体证件？ *</label>
          <textarea
            id="applicationReason"
            name="applicationReason"
            rows="4"
            required
          ></textarea>
        </div>

        <div class="form-field">
          <span>是否曾参加过本电影节？</span>
          <div class="radio-group">
            <label>
              <input type="radio" name="attendedBefore" value="yes" />
              是
            </label>
            <label>
              <input type="radio" name="attendedBefore" value="no" />
              否
            </label>
          </div>
        </div>

        <div class="form-field">
          <label for="additionalNotes">其他说明</label>
          <textarea
            id="additionalNotes"
            name="additionalNotes"
            rows="4"
          ></textarea>
        </div>

        <div class="form-field form-field--checkbox">
          <label>
            <input id="privacyConsent" name="privacyConsent" type="checkbox" required />
            我已阅读并同意隐私政策 *
          </label>
        </div>
      </fieldset>

      <div class="accreditation-form__actions">
        <button type="submit">提交申请</button>
      </div>
    </form>

    <h2>联系方式</h2>
    <p>info@chinesefilmfest.de</p>
  </div>
</ArticleLayout>

<style lang="scss">
  body {
    font-family: 'Noto Sans SC', sans-serif;
  }

  .accreditation-form {
    margin-top: 1.5rem;
  }

  .accreditation-form__section {
    margin: 0 0 2rem;
    padding: 1.5rem;
    border: 1px solid #d9d9d9;
  }

  .accreditation-form__section legend {
    padding: 0 0.5rem;
    font-size: 1.1rem;
    font-weight: 700;
  }

  .form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem 1.25rem;
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-bottom: 1rem;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 0.8rem 0.95rem;
    border: 1px solid #cfcfcf;
    border-radius: 0;
    font: inherit;
    background: #fff;
    box-sizing: border-box;
  }

  .form-field textarea {
    resize: vertical;
  }

  .form-help {
    margin: 0;
    font-size: 0.92rem;
    color: #666;
  }

  .radio-group {
    display: flex;
    gap: 1.5rem;
    margin-top: 0.35rem;
  }

  .radio-group label {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .form-field--checkbox label {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .form-field--checkbox input {
    width: auto;
    margin-top: 0.2rem;
  }

  .accreditation-form__actions {
    margin-top: 1.5rem;
  }

  .accreditation-form__actions button {
    padding: 0.85rem 1.4rem;
    border: 0;
    background: #111;
    color: #fff;
    font: inherit;
    cursor: pointer;
  }

  @media (max-width: 768px) {
    .form-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
