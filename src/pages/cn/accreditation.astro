---
import ArticleLayout from "../../layouts/ArticleLayout.astro";

const page = {
  frontmatter: {
    headline: "证件申请",
    headline2: "证件申请"
  }
};
---

<ArticleLayout title={page.frontmatter.headline} article={page}>
  <div class="text-module__head">
    <blockquote class="text-module__headline">
      <div>{page.frontmatter.headline2}</div>
    </blockquote>
  </div>

  <div class="text-module">
    <h2>申请说明</h2>
    <p>欢迎申请本届影像展相关证件。提交后，我们将在审核后通过邮件联系您。</p>

    <h2>申请对象</h2>
    <p>媒体</p>

    <h2>申请材料</h2>
    <p>姓名、所属机构、联系方式、申请类别、证件照、补充说明</p>

    <h2>申请入口</h2>
    <p>
      <a href="REPLACE_WITH_FORM_LINK" target="_blank" rel="noopener noreferrer">
        立即申请
      </a>
    </p>

    <h2>联系方式</h2>
    <p>info@chinesefilmfest.de</p>
  </div>
</ArticleLayout>

<style lang="scss">
  body {
    font-family: 'Noto Sans SC', sans-serif;
  }
</style>
