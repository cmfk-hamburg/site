---
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import * as accreditation from "../../content/cn/accreditation.md";

const Content = accreditation.Content;
---

<ArticleLayout title={accreditation.frontmatter.htmlTitle} article={accreditation}>
  <div class="text-module__head">
    <h2 class="text-module__headline">
      {accreditation.frontmatter.headline2}
    </h2>
    <div class="text-module__cta-wrapper">
      <a
        class="text-module__cta btn btn--primary"
        href={accreditation.frontmatter.buttonLink}
        target="_blank"
      >
        {accreditation.frontmatter.buttonText}
      </a>
    </div>
  </div>

  <div class="text-module__content">
    <Content />
  </div>
</ArticleLayout>
