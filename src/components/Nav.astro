---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const subnavDemoLabel = lang === "cn" ? "子导航示例" : "Sub-Nav Demo";

const pathname = new URL(Astro.request.url).pathname;

const itemClass = function (path: string) {
	return pathname === path ? "nav__item is-active" : "nav__item";
};

const subItemClass = function (path: string) {
	return pathname.startsWith(path) ? "nav__item is-active" : "nav__item";
};
---

<nav role="navigation" class="nav">
	<ul class="nav__list">
		<li class={itemClass(`/${lang}/`)}>
			<a href={`/${lang}/`} class="nav__link" title={t("nav.home")}>
				<span class="nav__link-text"> # </span>
			</a>
		</li>
		<li class={itemClass(`/${lang}/call-for-entries/`)}>
			<a
				href={`/${lang}/call-for-entries/`}
				class="nav__link"
				title={t("nav.callForFilm")}
			>
				<span class="nav__link-text">
					{t("nav.callForFilm")}
				</span>
			</a>
		</li>
		<li class={`${subItemClass(`/${lang}/about/`)} nav__item--has-children`}>
			<button
				type="button"
				class="nav__link nav__toggle"
				title={t("nav.about")}
				aria-expanded="false"
				aria-controls={`about-subnav-${lang}`}
				data-nav-toggle
			>
				<span class="nav__link-text">
					{t("nav.about")}
				</span>
				<span class="nav__indicator" aria-hidden="true"></span>
			</button>
			<ul
				id={`about-subnav-${lang}`}
				class="nav__sublist"
				aria-label={t("nav.about")}
			>
				<li class={itemClass(`/${lang}/about/`)}>
					<a
						href={`/${lang}/about/`}
						class="nav__sublink"
						title={t("nav.festival")}
					>
						<span class="nav__link-text">{t("nav.festival")}</span>
					</a>
				</li>
				<li class={itemClass(`/${lang}/about/team/`)}>
					<a
						href={`/${lang}/about/team/`}
						class="nav__sublink"
						title={t("nav.team")}
					>
						<span class="nav__link-text">{t("nav.team")}</span>
					</a>
				</li>
				<li class={itemClass(`/${lang}/about/archive/`)}>
					<a
						href={`/${lang}/about/archive/`}
						class="nav__sublink"
						title={t("nav.archive")}
					>
						<span class="nav__link-text">{t("nav.archive")}</span>
					</a>
				</li>
			</ul>
		</li>
		<li class={subItemClass(`/${lang}/program/`)}>
			<a href={`/${lang}/program/`} class="nav__link" title={t("nav.program")}>
				<span class="nav__link-text">
					{t("nav.program")}
				</span>
			</a>
		</li>
		<!-- <li class={subItemClass(`/${lang}/tickets/`)}>
			<a href={`/${lang}/tickets/`} class="nav__link" title={t("nav.tickets")}>
				<span class="nav__link-text">
					{t("nav.tickets")}
				</span>
			</a>
		</li> -->
		<li class={subItemClass(`/${lang}/join-us/`)}>
			<a href={`/${lang}/join-us/`} class="nav__link" title={t("nav.joinUs")}>
				<span class="nav__link-text">
					{t("nav.joinUs")}
				</span>
			</a>
		</li>
	</ul>
</nav>

<style lang="scss">
	@import "../styles/variables.scss";
	@import "../styles/fonts.scss";
	@import "../styles/utils.scss";

	.nav {
		position: fixed;
		z-index: 100;
		left: 0;
		right: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: pxToRem(8px);
		justify-content: center;
		padding: pxToRem(6px);
		height: fit-content;

		@include breakpoint(xs-sm) {
			bottom: pxToRem(24px);
		}

		@include breakpoint(md-xl) {
			bottom: pxToRem(80px);
		}
		@include breakpoint(lg) {
			bottom: pxToRem(72px);
		}

		&.is-sticky {
			position: sticky;
		}
	}

	.nav__list {
		// @include blur-background;
		// @include rounded-border;
		box-sizing: border-box;
		display: inline-flex;
		flex-wrap: nowrap;
		list-style: none;
		margin: 0;
		padding: pxToRem(4px);
		overflow: visible;
		pointer-events: all;
		background-color: $c-white;
		box-shadow: 0 0 pxToRem(12px) 0 rgba(0, 0, 0, 0.2);
		border-radius: 4px;
	}

	.nav__item {
		@include f-btn;

		@include breakpoint(md-xl) {
			margin-inline: pxToRem(12px);
		}

		&.is-active {
			// @include rounded-border;
			border-radius: 4px;
			background-color: $c-green;
			color: $c-white;
		}
	}

	.nav__item--has-children {
		position: relative;
	}

	.nav__link {
		// @include rounded-border;
		display: flex;
		align-items: center;
		padding-inline: pxToRem(12px);
		height: pxToRem(40px);
		transition: all $d-anim ease-in-out;
		color: $c-black;
		background-color: transparent;
		border-radius: 4px;
		gap: pxToRem(6px);

		.is-active > & {
			color: $c-white;
		}

		&:hover {
			cursor: pointer;
			color: $c-green;
		}
	}

	.nav__indicator {
		width: pxToRem(6px);
		height: pxToRem(6px);
		display: inline-block;
		flex-shrink: 0;
		border-radius: 999px;
		background-color: $c-green;
		transform: translateY(-1px);

		.is-active & {
			background-color: $c-white;
		}
	}

	.nav__sublist {
		box-sizing: border-box;
		display: none;
		position: absolute;
		left: 0;
		transform: none;
		bottom: calc(100% + pxToRem(8px));
		flex-wrap: nowrap;
		list-style: none;
		margin: 0;
		padding: pxToRem(2px);
		overflow: hidden;
		pointer-events: all;
		background-color: $c-white;
		box-shadow: 0 0 pxToRem(10px) 0 rgba(0, 0, 0, 0.2);
		border-radius: 4px;
		z-index: 1;
		min-width: max-content;
	}

	.nav__sublist::before {
		content: "";
		position: absolute;
		left: pxToRem(16px);
		bottom: pxToRem(-6px);
		width: 0;
		height: 0;
		border-left: pxToRem(6px) solid transparent;
		border-right: pxToRem(6px) solid transparent;
		border-top: pxToRem(6px) solid $c-white;
		filter: drop-shadow(0 pxToRem(2px) pxToRem(2px) rgba(0, 0, 0, 0.1));
	}

	.nav__item--has-children.is-open .nav__sublist {
		display: inline-flex;
	}

	.nav__toggle {
		appearance: none;
		border: 0;
		background: transparent;
		font: inherit;
	}

	.nav__sublink {
		display: flex;
		align-items: center;
		padding-inline: pxToRem(10px);
		height: pxToRem(34px);
		width: max-content;
		transition: all $d-anim ease-in-out;
		color: $c-black;
		background-color: transparent;
		border-radius: 4px;

		.is-active > & {
			color: $c-white;
		}

		&:hover {
			cursor: pointer;
			color: $c-green;
		}
	}
</style>

<script type="text/javascript">
	const nav = document.querySelector(".nav");
	if (nav) {
		const toggles = nav.querySelectorAll("[data-nav-toggle]");

		const closeAll = (except) => {
			toggles.forEach((toggle) => {
				const item = toggle.closest(".nav__item--has-children");
				if (!item || item === except) return;
				item.classList.remove("is-open");
				toggle.setAttribute("aria-expanded", "false");
			});
		};

		toggles.forEach((toggle) => {
			toggle.addEventListener("click", (event) => {
				event.stopPropagation();
				const item = toggle.closest(".nav__item--has-children");
				if (!item) return;
				const isOpen = item.classList.contains("is-open");
				closeAll(item);
				if (isOpen) {
					item.classList.remove("is-open");
					toggle.setAttribute("aria-expanded", "false");
				} else {
					item.classList.add("is-open");
					toggle.setAttribute("aria-expanded", "true");
				}
			});
		});

		nav.addEventListener("click", (event) => {
			const target = event.target;
			if (target && target.closest && target.closest(".nav__sublink")) {
				closeAll();
			}
		});

		document.addEventListener("click", (event) => {
			if (!nav.contains(event.target)) {
				closeAll();
			}
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") {
				closeAll();
			}
		});
	}
</script>
